generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  role          String    @default("CLIENT")
  phone         String?
  avatar        String?
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  permissions   String?
  emailVerified  Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  leads             Lead[]
  managedProjects   Project[]        @relation("ProjectManager")
  assignedTasks     Task[]           @relation("TaskAssignee")
  notifications     Notification[]
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  uploadedDocuments Document[]
  timeEntries       TimeEntry[]
  inspections       Inspection[]     @relation("Inspector")
  safetyReports     SafetyReport[]
  conductedVisits   SiteVisit[]      @relation("SiteVisitConductor")
  createdQuotations Quotation[]      @relation("QuotationCreator")
  approvedOrders    PurchaseOrder[]  @relation("OrderApprover")
  receivedReceipts  MaterialReceipt[] @relation("ReceiptReceiver")
  inventoryMovements InventoryMovement[]
  raisedNCRs        NCR[]            @relation("NCRRaisedBy")
  assignedNCRs      NCR[]            @relation("NCRApprovedBy")
  createdEstimates  Estimate[]
  createdCampaigns  Campaign[]
  clients           Client[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   String?
  city      String?
  state     String?
  country   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  isActive  Boolean   @default(true)
  type      String?
  parentId  String?
  parent    Branch?   @relation("BranchHierarchy", fields: [parentId], references: [id])
  children  Branch[]  @relation("BranchHierarchy")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
  leads     Lead[]
  clients   Client[]
  vendors   Vendor[]
  contracts Contract[]
}

model Client {
  id          String    @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  gstin       String?
  pan         String?
  type        String?
  source      String?
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
  leads       Lead[]
  invoices    Invoice[]
  contracts   Contract[]
  documents   Document[]
}

model Lead {
  id            String       @id @default(cuid())
  companyName   String?
  contactName   String
  email         String
  phone         String?
  source        String?
  status        String       @default("NEW")
  projectType   String?
  description   String?
  budget        Float?
  location      String?
  plotSize      Float?
  builtUpArea   Float?
  timeline      String?
  notes         String?
  assignedToId  String?
  assignedTo    User?        @relation(fields: [assignedToId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quotations    Quotation[]
  siteVisits    SiteVisit[]
  documents     Document[]
  tasks         Task[]
}

model Quotation {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  title       String
  amount      Float?
  description String?
  status      String   @default("DRAFT")
  validUntil  DateTime?
  notes       String?
  createdById String?
  createdBy   User?    @relation("QuotationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lineItems   QuotationLineItem[]
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  description String
  quantity    Float
  unit        String?
  unitPrice   Float
  total       Float
  createdAt   DateTime  @default(now())
}

model SiteVisit {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  scheduledAt   DateTime
  status        String   @default("SCHEDULED")
  notes         String?
  address       String?
  conductedById String?
  conductedBy   User?    @relation("SiteVisitConductor", fields: [conductedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id               String          @id @default(cuid())
  name             String
  description      String?
  type             String?
  status           String          @default("PLANNING")
  priority         String?
  clientId         String?
  client           Client?         @relation(fields: [clientId], references: [id])
  projectManagerId String?
  projectManager   User?           @relation("ProjectManager", fields: [projectManagerId], references: [id])
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  location         String?
  plotSize         Float?
  builtUpArea      Float?
  budget           Float?
  actualCost       Float?
  startDate        DateTime?
  endDate          DateTime?
  estimatedDuration String?
  contractId       String?
  contract         Contract?       @relation(fields: [contractId], references: [id])
  notes            String?
  progress         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  milestones       Milestone[]
  tasks            Task[]
  documents        Document[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
  equipmentAssignments EquipmentAssignment[]
  timeEntries      TimeEntry[]
  inspections      Inspection[]
  qualityChecks    QualityCheck[]
  safetyReports    SafetyReport[]
  variations       Variation[]
  phases           ProjectPhase[]
  budgets          ProjectBudget[]
  ncr              NCR[]
}

model ProjectPhase {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  description String?
  order       Int
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("PENDING")
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      String   @default("PENDING")
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  title          String
  description    String?
  status         String   @default("TODO")
  priority       String   @default("MEDIUM")
  assigneeId     String?
  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate        DateTime?
  completedAt    DateTime?
  parentId       String?
  wbsCode        String?
  estimatedHours Float?
  actualHours    Float?
  order          Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String?
  category     String?
  fileUrl      String
  fileSize     Int?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  isPublic     Boolean  @default(false)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contract {
  id        String    @id @default(cuid())
  title     String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  amount    Float?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("DRAFT")
  type      String?
  terms     String?
  signedDate DateTime?
  fileUrl   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Variation {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  amount      Float?
  status      String   @default("PENDING")
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vendor {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  gstin       String?
  category    String?
  rating      Int?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders  PurchaseOrder[]
  materialReceipts MaterialReceipt[]
}

model Material {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique
  category        String?
  unit            String?
  unitPrice       Float?
  minStock        Float?
  currentStock    Float    @default(0)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchaseOrderItems PurchaseOrderItem[]
  materialReceipts   MaterialReceiptItem[]
  inventoryMovements InventoryMovement[]
}

model PurchaseOrder {
  id            String     @id @default(cuid())
  poNumber      String     @unique
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id])
  vendorId      String?
  vendor        Vendor?    @relation(fields: [vendorId], references: [id])
  status        String     @default("DRAFT")
  orderDate     DateTime   @default(now())
  expectedDate  DateTime?
  deliveryDate  DateTime?
  subtotal      Float?
  tax           Float?
  total         Float?
  notes         String?
  approvedById  String?
  approvedBy    User?      @relation("OrderApprover", fields: [approvedById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String    @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id])
  description     String
  quantity        Float
  unit            String?
  unitPrice       Float
  total           Float
  receivedQty     Float     @default(0)
  createdAt       DateTime  @default(now())
}

model MaterialReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String?
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  projectId       String?
  receivedAt      DateTime @default(now())
  receivedById    String?
  receivedBy      User?    @relation("ReceiptReceiver", fields: [receivedById], references: [id])
  notes           String?
  createdAt       DateTime @default(now())
  items           MaterialReceiptItem[]
}

model MaterialReceiptItem {
  id               String          @id @default(cuid())
  materialReceiptId String
  materialReceipt  MaterialReceipt @relation(fields: [materialReceiptId], references: [id])
  materialId       String?
  material         Material?       @relation(fields: [materialId], references: [id])
  quantity         Float
  unit             String?
  batchNo          String?
  expiryDate       DateTime?
  createdAt        DateTime        @default(now())
}

model InventoryMovement {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  type        String
  quantity    Float
  referenceId String?
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Equipment {
  id                String   @id @default(cuid())
  name              String
  code              String?  @unique
  type              String?
  model             String?
  make              String?
  year              Int?
  plateNumber       String?
  vinNumber         String?
  status            String   @default("AVAILABLE")
  condition         String?
  location          String?
  latitude          Float?
  longitude         Float?
  purchaseDate      DateTime?
  purchasePrice     Float?
  hourlyRate        Float?
  fuelType          String?
  fuelCapacity      Float?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  meterReading      Float?
  branchId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assignments       EquipmentAssignment[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs          FuelLog[]
}

model EquipmentAssignment {
  id          String   @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  assignedFrom DateTime
  assignedTo  DateTime?
  notes       String?
  operatorId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaintenanceRecord {
  id            String   @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  type          String
  description   String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  cost          Float?
  vendor        String?
  notes         String?
  performedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FuelLog {
  id          String   @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  date        DateTime @default(now())
  quantity    Float
  unitPrice   Float
  totalCost   Float
  meterReading Float?
  filledBy    String?
  notes       String?
  createdAt   DateTime @default(now())
}

model TimeEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  date         DateTime
  hours        Float
  type         String   @default("REGULAR")
  description  String?
  approved     Boolean  @default(false)
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("PRESENT")
  notes     String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, date])
}

model Payroll {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  basicPay   Float?
  allowances Float?
  deductions Float?
  netPay     Float?
  status     String   @default("PENDING")
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, month, year])
}

model SafetyReport {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  title        String
  type         String
  description  String?
  severity     String   @default("LOW")
  location     String?
  reportedById String
  reportedBy   User     @relation(fields: [reportedById], references: [id])
  status       String   @default("OPEN")
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actions      SafetyAction[]
}

model SafetyAction {
  id            String   @id @default(cuid())
  safetyReportId String
  safetyReport  SafetyReport @relation(fields: [safetyReportId], references: [id])
  description   String
  assignedToId  String?
  dueDate       DateTime?
  completedAt   DateTime?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model Inspection {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  title         String
  type          String
  description   String?
  scheduledAt   DateTime?
  conductedAt   DateTime?
  conductedById String?
  conductedBy   User?    @relation("Inspector", fields: [conductedById], references: [id])
  result        String?
  status        String   @default("SCHEDULED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QualityCheck {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  checkType   String?
  standard    String?
  result      String?
  status      String   @default("PENDING")
  checkedById String?
  checkedAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NCR {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  title            String
  description      String?
  severity         String   @default("MINOR")
  status           String   @default("OPEN")
  raisedById       String?
  raisedBy         User?    @relation("NCRRaisedBy", fields: [raisedById], references: [id])
  assignedToId     String?
  assignedTo       User?    @relation("NCRApprovedBy", fields: [assignedToId], references: [id])
  correctiveAction String?
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Invoice {
  id         String   @id @default(cuid())
  invoiceNo  String   @unique
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  type       String   @default("CLIENT")
  amount     Float
  tax        Float?
  total      Float
  status     String   @default("DRAFT")
  dueDate    DateTime?
  issuedAt   DateTime?
  paidAt     DateTime?
  paymentMode String?
  notes      String?
  gstInvoice Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lineItems  InvoiceLineItem[]
  payments   Payment[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Float
  unit        String?
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float
  date      DateTime @default(now())
  mode      String?
  reference String?
  notes     String?
  createdAt DateTime @default(now())
}

model ProjectBudget {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  category  String
  allocated Float
  spent     Float    @default(0)
  committed Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String?
  type      String   @default("INFO")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  projectId  String?
  subject    String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Estimate {
  id          String   @id @default(cuid())
  leadId      String?
  projectId   String?
  type        String
  totalAmount Float?
  currency    String   @default("INR")
  status      String   @default("DRAFT")
  assumptions String?
  exclusions  String?
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       EstimateItem[]
}

model EstimateItem {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  category    String?
  description String
  quantity    Float
  unit        String?
  unitRate    Float
  amount      Float
  createdAt   DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String
  status      String   @default("DRAFT")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  spent       Float    @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  roi         Float?
  description String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Integration {
  id        String   @id @default(cuid())
  name      String
  type      String
  apiKey    String?
  apiSecret String?
  endpoint  String?
  status    String   @default("ACTIVE")
  config    String?
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
